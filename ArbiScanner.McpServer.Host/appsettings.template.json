{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://localhost:3100",
          "labels": [
            { "key": "app", "value": "arbiscanner-mcp" },
            { "key": "env", "value": "development" }
          ],
          "propertiesAsLabels": [ "level" ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Observability": {
    "Enabled": true
  },
  "VerboseLogging": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "https://auth.arbiscannerwebapp.site/realms/arbiscanner-web",
    "Audience": "arbiscanner-mcp"
  },
  "OutboundKeycloak": {
    "Authority": "https://auth.arbiscannerwebapp.site/realms/arbiscanner-web",
    "ClientId": "arbiscanner-mcp",
    "ClientSecret": "",
    "RefreshToken": ""
  },
  "WebApi": {
    "BaseUrl": "http://localhost:5267"
  }
}
