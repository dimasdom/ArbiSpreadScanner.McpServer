## .NET gitignore

# macOS
.DS_Store

# Environment secrets
.env
*.env.local

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/

# Test results
[Tt]est[Rr]esult*/
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Publish
publish/
*.[Pp]ublish.xml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
*.nuget.props
*.nuget.targets

# Coverage
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# MSBuild logs
*.binlog

# Local History / IDE
.localhistory/
.ionide/

# Windows-generated build paths
**/obj*/
**/bin*/

# Local secrets - see appsettings*.template.json for the expected shape
appsettings.json
appsettings.Development.json
